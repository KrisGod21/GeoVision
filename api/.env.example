# Origins allowed to call the API. Comma-separated, no trailing slash.
# Never set this to "*" -- these endpoints accept file uploads.
GEOVISION_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where job artifacts are written. In deployment point this at a mounted
# volume, otherwise results vanish on redeploy.
GEOVISION_STORAGE_DIR=./api/storage

# Which extractor implementation to use. "stub" until the trained model lands.
GEOVISION_EXTRACTOR=stub
